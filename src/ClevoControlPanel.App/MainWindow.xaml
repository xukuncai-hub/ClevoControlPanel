<ui:FluentWindow x:Class="ClevoControlPanel.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ClevoControlPanel.App.Views"
                 Title="Clevo Control Panel"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180" Height="800"
                 MinWidth="1040" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="Transparent"
                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
                 Language="zh-CN"
                 UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="True" ShowMaximize="True" ShowClose="True">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <ui:Button Appearance="Transparent" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                               Command="{Binding RestartAsAdminCommand}"
                               Visibility="{Binding IsElevationButtonVisible, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="以管理员身份重启（若驱动访问受限）" Margin="0,0,4,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Shield24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                               Command="{Binding ToggleThemeCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="ToolTip" Value="切换到深色主题" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="ToolTip" Value="切换到浅色主题" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="WeatherMoon24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Symbol" Value="WeatherSunny24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="16,0,16,6">
            <ui:InfoBar Severity="Warning" IsOpen="{Binding IsSimulation, Mode=OneWay}" IsClosable="False"
                        Title="模拟模式" Message="{Binding BackendStatus}" Margin="0,0,0,6" />
            <ui:InfoBar Severity="{Binding StatusSeverity}" IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                        IsClosable="True" Title="{Binding StatusTitle}" Message="{Binding StatusMessage}"
                        Margin="0,0,0,6" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="198" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,6,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="SideNav"
                             SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" CornerRadius="9" Background="Transparent">
                                                <Grid>
                                                    <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            HorizontalAlignment="Left" Opacity="0" />
                                                    <ContentPresenter Margin="14,14,10,14" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Gauge24" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Text="性能模式" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Temperature24" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Text="散热与风扇" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Text="键盘灯效" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Text="系统与设置" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel Grid.Row="1">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="11,9" ToolTip="{Binding BackendStatus}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding BackendBadgeBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding BackendBadgeText}" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,6,18,0" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource TelemetryChip}" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Laptop24" FontSize="13.5" Foreground="#FFB454"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding HardwareSummary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TelemetryChip}" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Gauge24" FontSize="13.5" Foreground="#4CC2FF"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CpuLoadPercent, StringFormat=负载 {0:F0}%}" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TelemetryChip}" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Temperature24" FontSize="13.5" Foreground="#FF8A6A"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CpuSummary}" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TelemetryChip}" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="13.5" Foreground="#73E0C1"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding GpuSummary}" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TelemetryChip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="TopSpeed24" FontSize="13.5" Foreground="#B07CFF"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding PowerModeDisplay}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource TelemetryChip}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="13.5" Foreground="#3AB795"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding PowerStatusSummary}" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding LastUpdated, StringFormat=更新 {0}}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <views:PerformanceView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}" />
                    <views:CoolingView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
                    <views:LightingView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}" />
                    <views:SettingsView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
