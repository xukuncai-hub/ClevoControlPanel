<UserControl x:Class="ClevoControlPanel.App.Views.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ClevoControlPanel.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="820">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2,4,18,20">
            <TextBlock Text="键盘灯效" Style="{StaticResource PageTitle}" />
            <TextBlock Text="整块键盘统一调色、五种灯效、四档亮度与 EC 硬件休眠计时。"
                       Style="{StaticResource PageSubtitle}" Margin="0,6,0,18" />

            <ui:InfoBar Severity="Warning" IsOpen="{Binding IsKeyboardCapabilityWarningOpen, Mode=OneWay}"
                        IsClosable="False" Title="键盘能力" Message="{Binding KeyboardCapabilityNotice}"
                        Margin="0,0,0,14" />

            <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <controls:KeyboardPreview Height="224"
                                              LeftColor="{Binding LeftZoneColor}"
                                              MiddleColor="{Binding MiddleZoneColor}"
                                              RightColor="{Binding RightZoneColor}"
                                              Brightness="{Binding KeyboardBrightness}"
                                              IsPowered="{Binding IsKeyboardPowerOn}" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                            Background="#C2141820"
                            BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="14"
                                           Foreground="#D9FFFFFF" />
                            <TextBlock Text="{Binding SelectedEffectOption.Title}" FontSize="11.5" FontWeight="SemiBold"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="#F2FFFFFF" />
                            <TextBlock Text=" · " FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="#99FFFFFF" />
                            <TextBlock Text="{Binding BrightnessText}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="#D9FFFFFF" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0"
                        IsEnabled="{Binding SupportsRgbKeyboard}">
                    <StackPanel>
                        <TextBlock Text="键盘颜色" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="整块键盘统一使用一种颜色，拖动 RGB 滑块或点选预设色即时生效。" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,14" />

                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="12"
                                    Background="{Binding CurrentColorBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="当前颜色" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentColorHex}" FontSize="20" FontWeight="SemiBold"
                                           Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" Foreground="#FF7B7B" FontWeight="Bold" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="8,0,10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Red, StringFormat={}{0:F0}}"
                                       Style="{StaticResource ChannelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" Foreground="#6BE39A" FontWeight="Bold" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="8,0,10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Green, StringFormat={}{0:F0}}"
                                       Style="{StaticResource ChannelValue}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" Foreground="#7EC2FF" FontWeight="Bold" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="8,0,10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Blue, StringFormat={}{0:F0}}"
                                       Style="{StaticResource ChannelValue}" />
                        </Grid>

                        <TextBlock Text="预设色" Style="{StaticResource MutedText}" Margin="0,18,0,8" />
                        <ItemsControl ItemsSource="{Binding ColorPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="32" Height="32" Margin="0,0,8,8" Padding="0"
                                            BorderThickness="1.5" Cursor="Hand"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            ToolTip="{Binding Name}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Color}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Swatch" Background="{Binding Brush}" CornerRadius="9"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        RenderTransformOrigin="0.5,0.5" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Swatch" Property="BorderBrush"
                                                                Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Setter TargetName="Swatch" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding SupportsRgbKeyboard}">
                        <StackPanel>
                            <TextBlock Text="灯效模式" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="键盘固件不支持动画；灯效由应用以 10 FPS 驱动颜色，关闭应用后停止。" Style="{StaticResource MutedText}"
                                       Margin="0,4,0,14" />

                            <ListBox ItemsSource="{Binding EffectOptions}"
                                     SelectedItem="{Binding SelectedEffectOption, Mode=TwoWay}"
                                     Style="{StaticResource SelectionListBox}"
                                     Margin="-3,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionListBoxItem}">
                                        <Setter Property="Margin" Value="3,0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="EffectCard" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="0">
                                            <Grid>
                                                <Border x:Name="EffectTint" CornerRadius="9"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Opacity="0" IsHitTestVisible="False" />
                                                <StackPanel HorizontalAlignment="Center" Margin="4,12">
                                                    <ui:SymbolIcon x:Name="EffectIcon" Symbol="{Binding Icon}" FontSize="20"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                         Value="True">
                                                <Setter TargetName="EffectTint" Property="Opacity" Value="0.06" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                         Value="True">
                                                <Setter TargetName="EffectCard" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Setter TargetName="EffectCard" Property="BorderThickness" Value="1.8" />
                                                <Setter TargetName="EffectTint" Property="Opacity" Value="0.14" />
                                                <Setter TargetName="EffectIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="动画速度" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding EffectSpeedText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="10" Value="{Binding EffectSpeed, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                            IsEnabled="{Binding HasKeyboardBacklight}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="亮度与开关" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding BrightnessText}" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding IsKeyboardPowerOn, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Minimum="0" Maximum="4" Value="{Binding KeyboardBrightness, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,10,0,0" />

                            <UniformGrid Columns="5" Margin="-3,8,-3,0">
                                <ui:Button Content="关灯" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,4" FontSize="11.5"
                                           Command="{Binding SetQuickBrightnessCommand}" CommandParameter="0" />
                                <ui:Button Content="25%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,4" FontSize="11.5"
                                           Command="{Binding SetQuickBrightnessCommand}" CommandParameter="1" />
                                <ui:Button Content="50%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,4" FontSize="11.5"
                                           Command="{Binding SetQuickBrightnessCommand}" CommandParameter="2" />
                                <ui:Button Content="75%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,4" FontSize="11.5"
                                           Command="{Binding SetQuickBrightnessCommand}" CommandParameter="3" />
                                <ui:Button Content="100%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,4" FontSize="11.5"
                                           Command="{Binding SetQuickBrightnessCommand}" CommandParameter="4" />
                            </UniformGrid>

                            <Separator Margin="0,16,0,14" Opacity="0.35" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="休眠延时" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="空闲后由 EC 自动关灯" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SleepOptions}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{Binding SelectedSleepOption, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
