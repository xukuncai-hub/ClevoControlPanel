<UserControl x:Class="ClevoControlPanel.App.Views.CoolingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ClevoControlPanel.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2,4,18,20">
            <TextBlock Text="散热与风扇" Style="{StaticResource PageTitle}" />
            <TextBlock Text="实时读取 EC 传感器，并直接控制风扇策略、偏移与 Turbo 强冷。"
                       Style="{StaticResource PageSubtitle}" Margin="0,6,0,18" />

            <ui:InfoBar Severity="Warning" IsOpen="{Binding IsThermalWarning, Mode=OneWay}"
                        IsClosable="False" Title="温度提示" Message="{Binding ThermalWarningText}"
                        Margin="0,0,0,14" />
            <ui:InfoBar Severity="Warning" IsOpen="{Binding IsFanControlUnavailable, Mode=OneWay}"
                        IsClosable="False" Title="无风扇控制" Message="{Binding FanControlNotice}"
                        Margin="0,0,0,14" />

            <UniformGrid Columns="4" Margin="-6,0,-6,14">
                <Border Style="{StaticResource CardBorder}" Padding="6" Margin="6,0">
                    <controls:ArcGauge Value="{Binding CpuTemperature}" Maximum="100" WarningThreshold="90"
                                       Title="CPU 温度" Unit="°C" SubText="{Binding CpuTempSubText}"
                                       AccentColor="#FF6B6B" WarningColor="#FF3B30"
                                       TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                       MutedTextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                       Height="188" />
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="6" Margin="6,0">
                    <controls:ArcGauge Value="{Binding GpuTemperature}" Maximum="100" WarningThreshold="88"
                                       Title="GPU 温度" Unit="°C" SubText="{Binding GpuTempSubText}"
                                       AccentColor="#FFB454" WarningColor="#FF3B30"
                                       TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                       MutedTextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                       Height="188" />
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="6" Margin="6,0">
                    <controls:ArcGauge Value="{Binding CpuFanRpm}" Maximum="8000"
                                       Title="CPU 风扇" Unit="RPM" SubText="{Binding CpuFanSubText}"
                                       AccentColor="#4CC2FF"
                                       TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                       MutedTextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                       Height="188" />
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="6" Margin="6,0">
                    <controls:ArcGauge Value="{Binding GpuFanRpm}" Maximum="8000"
                                       Title="GPU 风扇" Unit="RPM" SubText="{Binding GpuFanSubText}"
                                       AccentColor="#73E0C1"
                                       TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                       MutedTextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                       Height="188" />
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.42*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0"
                        IsEnabled="{Binding IsFanControlAvailable}">
                    <StackPanel>
                        <TextBlock Text="风扇策略" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="选择 EC 固件的风扇曲线，或叠加 Turbo 强冷。" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,16" />

                        <ListBox ItemsSource="{Binding FanModeOptions}"
                                 SelectedItem="{Binding SelectedFanModeOption, Mode=TwoWay}"
                                 Style="{StaticResource SelectionListBox}"
                                 Margin="-4,0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionListBoxItem}">
                                    <Setter Property="Margin" Value="4,0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="0">
                                        <Grid>
                                            <Border x:Name="PillTint" CornerRadius="9"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Opacity="0" IsHitTestVisible="False" />
                                            <StackPanel HorizontalAlignment="Center" Margin="8,14">
                                                <ui:SymbolIcon x:Name="PillIcon" Symbol="{Binding Icon}" FontSize="22"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,7,0,0"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                     Value="True">
                                            <Setter TargetName="PillTint" Property="Opacity" Value="0.06" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                     Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Pill" Property="BorderThickness" Value="1.8" />
                                            <Setter TargetName="PillTint" Property="Opacity" Value="0.14" />
                                            <Setter TargetName="PillIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#22FF6B4A">
                                    <ui:SymbolIcon Symbol="Rocket24" FontSize="20" Foreground="#FF8A6A" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Turbo 强冷" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="高优先级冷却覆盖，自动切换为自动风扇曲线并全速运行。"
                                               Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding IsTurboFan, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                        IsEnabled="{Binding IsFanOffsetAvailable}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="风扇转速加成" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FanOffsetText}" FontSize="28" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding FanOffsetSummary}" FontSize="12"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                        <Border Margin="0,10,0,0" Padding="10,8,10,6" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <controls:FanOffsetCurve Height="94"
                                                         OffsetPercent="{Binding FanOffset}"
                                                         AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         DefaultBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                         GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                         LabelBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Grid Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="12" Height="2" VerticalAlignment="Center"
                                                   Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="EC 出厂曲线" FontSize="10.5" Margin="5,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Width="12" Height="2" VerticalAlignment="Center"
                                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="当前加成" FontSize="10.5" Margin="5,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="相对转速示意" FontSize="10" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Slider Minimum="0" Maximum="100" Value="{Binding FanOffset, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,10,0,0" />
                        <UniformGrid Columns="4" Margin="-3,8,-3,0">
                            <ui:Button Content="默认" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,5" FontSize="11.5"
                                       Command="{Binding SetQuickOffsetCommand}" CommandParameter="0" ToolTip="恢复出厂自动曲线" />
                            <ui:Button Content="轻度 +25%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,5" FontSize="11.5"
                                       Command="{Binding SetQuickOffsetCommand}" CommandParameter="25" ToolTip="同温度下略微提高转速" />
                            <ui:Button Content="较强 +50%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,5" FontSize="11.5"
                                       Command="{Binding SetQuickOffsetCommand}" CommandParameter="50" ToolTip="明显强化散热" />
                            <ui:Button Content="最大 +100%" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="3,0" Padding="0,5" FontSize="11.5"
                                       Command="{Binding SetQuickOffsetCommand}" CommandParameter="100" ToolTip="风扇基本保持最高转速" />
                        </UniformGrid>
                        <TextBlock Text="0% 完全跟随 EC 出厂曲线；加成越大，同一温度下风扇转速越高。"
                                   Style="{StaticResource MutedText}" Margin="0,10,0,0" />

                        <Separator Margin="0,16,0,14" Opacity="0.35" />

                        <TextBlock Text="传感器详情" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="CPU 风扇 PWM" Style="{StaticResource MutedText}" Margin="0,0,0,9" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuFanDuty, StringFormat={}{0}%}"
                                       FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="1" Text="GPU 风扇 PWM" Style="{StaticResource MutedText}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuFanDuty, StringFormat={}{0}%}"
                                       FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="2" Text="GPU 电源状态" Style="{StaticResource MutedText}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GpuStateText}"
                                       FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="3" Text="主板环境温度" Style="{StaticResource MutedText}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemTempSummary}"
                                       FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,9" />
                            <TextBlock Grid.Row="4" Text="遥测刷新时间" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastUpdated}"
                                       FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
