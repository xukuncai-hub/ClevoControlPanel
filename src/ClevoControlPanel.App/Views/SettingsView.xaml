<UserControl x:Class="ClevoControlPanel.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2,4,18,20">
            <TextBlock Text="系统与设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="管理系统常驻偏好、官方后台服务接管与高温应急安全防护。"
                       Style="{StaticResource PageSubtitle}" Margin="0,6,0,18" />

            <!-- Hardware Specs Overview Card -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="13" Background="#1F4CC2FF" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Laptop24" FontSize="23"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="硬件规格概览" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#1F4CC2FF" CornerRadius="7" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HardwareSummary}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="处理器 (CPU)" Style="{StaticResource MutedText}" Margin="0,0,12,7" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuModelName}" FontWeight="SemiBold" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="1" Text="独立显卡 (GPU)" Style="{StaticResource MutedText}" Margin="0,0,12,7" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuModelName}" FontWeight="SemiBold" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="2" Text="操作系统 (OS)" Style="{StaticResource MutedText}" Margin="0,0,12,7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OsDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,7" />

                            <TextBlock Grid.Row="3" Text="电源与电池" Style="{StaticResource MutedText}" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PowerStatusSummary}" FontWeight="SemiBold" Foreground="#3AB795" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="13" Background="#1F3AB795" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="23" Foreground="#3AB795" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="机型兼容性" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#1F3AB795" CornerRadius="7" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MachineDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E7F63" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CompatibilitySummary}" Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CompatibilityNote}" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- OEM Service Interception Card -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="13" Background="#1FFF9E44" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="23" Foreground="#FF9E44" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="官方后台服务接管" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#1FFF9E44" CornerRadius="7" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CCDCHUService" FontSize="10" FontWeight="SemiBold" Foreground="#FF9E44" />
                            </Border>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OemServiceStatusText}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}"
                                   Text="原厂控制中心常驻服务（CCDCHUService）可能会在后台定时重置风扇转速或性能模式。挂起官方服务可确保当前软件独占硬件控制权，不再被原版覆盖。" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding IsElevationButtonVisible, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Info16" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="控制 Windows 服务需管理员权限。点击按钮将自动发起 UAC 提权授权；亦可点击右侧“提权重启”。"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Command="{Binding ToggleOemServiceCommand}"
                                   Content="{Binding OemServiceButtonText}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Secondary" Command="{Binding RestartAsAdminCommand}"
                                   Visibility="{Binding IsElevationButtonVisible, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="以管理员身份重启当前控制面板">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shield24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="提权重启" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thermal Failsafe Card -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="13" Background="#22FF4D4D" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Fire24" FontSize="23" Foreground="#FF4D4D" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="高温应急散热熔断" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#1FFF4D4D" CornerRadius="7" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SAFETY GUARD" FontSize="10" FontWeight="SemiBold" Foreground="#FF4D4D" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}"
                                   Text="当 CPU 达到 94°C 或 GPU 达到 86°C 持续 3 秒时，无论当前为何种静音或自定义模式，自动激活强冷保护硬件；温度降至 75°C 以下自动恢复原模式。" />
                    </StackPanel>

                    <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggleStyle}"
                                  IsChecked="{Binding IsThermalSafetyEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Memory & Disk Overview -->
            <TextBlock Text="硬件资源监控" Style="{StaticResource SectionTitle}" Margin="0,6,0,10" />
            <UniformGrid Columns="2" Margin="-6,0,-6,14">
                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="17" Foreground="#6C8CFF" Margin="0,0,8,0" />
                                <TextBlock Text="物理内存 (RAM)" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding RamDetails}" FontSize="12" Margin="0,6,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar Value="{Binding RamUsagePercent}" Height="6"
                                         Foreground="#6C8CFF" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding RamUsagePercent, StringFormat={}{0:F0}%}"
                                   FontSize="22" FontWeight="Bold" Foreground="#6C8CFF" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Storage24" FontSize="17" Foreground="#3AB795" Margin="0,0,8,0" />
                                <TextBlock Text="系统硬盘 (C:)" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding DiskDetails}" FontSize="12" Margin="0,6,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar Value="{Binding DiskUsagePercent}" Height="6"
                                         Foreground="#3AB795" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DiskUsagePercent, StringFormat={}{0:F0}%}"
                                   FontSize="22" FontWeight="Bold" Foreground="#3AB795" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Preferences Card -->
            <TextBlock Text="偏好与自启" Style="{StaticResource SectionTitle}" Margin="0,6,0,10" />
            <Border Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="关闭窗口时最小化到系统托盘" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="保持后台温控与自动性能调度持续工作，双击托盘图标随时恢复窗口。"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}"
                                      IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16" Opacity="0.5" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机随 Windows 自动启动" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="登录 Windows 时自动启动并以静默托盘模式常驻运行。"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}"
                                      IsChecked="{Binding IsAutoStartupEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="0,6,0,10" />
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="13" Background="#1F6C8CFF" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Info24" FontSize="23"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AppDisplayName}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#1F6C8CFF" CornerRadius="7" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="轻量、便携的蓝天模具控制面板：性能模式、风扇控制、温度监控与键盘灯效。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="作者" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding AuthorName}" FontWeight="SemiBold"
                                       Margin="8,0,18,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="邮箱" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding OpenAuthorEmailCommand}"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">xukuncai0001@gmail.com</Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
