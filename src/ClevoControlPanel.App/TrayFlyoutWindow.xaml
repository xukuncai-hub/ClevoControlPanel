<Window x:Class="ClevoControlPanel.App.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        Language="zh-CN">
    <Grid>
        <Border x:Name="RootCard"
                Width="356"
                Margin="14"
                CornerRadius="14"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14"
                RenderOptions.ClearTypeHint="Enabled"
                TextOptions.TextFormattingMode="Display">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardSlideTransform" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                  Opacity="0.26" Color="#000000" RenderingBias="Performance" />
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="2,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Clevo Control Panel" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="6" Height="6" Fill="{Binding BackendBadgeBrush}"
                                     VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding BackendBadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text=" · " FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding PowerStatusSummary}" FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Width="30" Height="30" Padding="0" CornerRadius="8" Appearance="Transparent"
                                   Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                   Command="{Binding ToggleThemeCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="ToolTip" Value="切换到深色主题" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="ToolTip" Value="切换到浅色主题" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon FontSize="15">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="WeatherMoon24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Symbol" Value="WeatherSunny24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>
                        <ui:Button Width="30" Height="30" Padding="0" CornerRadius="8" Appearance="Transparent"
                                   Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                   Margin="4,0,0,0" Click="OpenMain_Click" ToolTip="打开主界面">
                            <ui:SymbolIcon Symbol="Open24" FontSize="15" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Live Telemetry Mini Cards -->
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Temperature24" FontSize="11.5" Foreground="#FF6B6B"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="CPU" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CpuTemperature, StringFormat={}{0}°C}"
                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding CpuFanRpm, StringFormat={}{0:N0} RPM}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="11.5" Foreground="#FFB454"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="GPU" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock FontSize="16" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding GpuTemperature, StringFormat={}{0}°C}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGpuStandby}" Value="True">
                                                <Setter Property="Text" Value="待机" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding GpuFanRpm, StringFormat={}{0:N0} RPM}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGpuStandby}" Value="True">
                                                <Setter Property="Text" Value="D3cold 休眠" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="9,7">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Gauge24" FontSize="11.5" Foreground="#4CC2FF"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="系统负载" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CpuLoadPercent, StringFormat={}{0:F0}%}"
                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding PowerModeDisplay}" FontSize="10" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Power Mode Quick Selector -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10,9" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="性能模式" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="自动调节" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ToggleButton Style="{StaticResource SwitchToggleSmallStyle}"
                                              IsChecked="{Binding IsAutoMode, Mode=TwoWay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ListBox ItemsSource="{Binding PowerModeOptions}"
                                 SelectedItem="{Binding SelectedPowerModeOption, Mode=TwoWay}"
                                 Style="{StaticResource SelectionListBox}"
                                 Margin="-2,8,-2,0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionListBoxItem}">
                                    <Setter Property="Margin" Value="2,0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1.2"
                                            CornerRadius="8"
                                            Padding="0">
                                        <Grid>
                                            <Border x:Name="PillTint"
                                                    CornerRadius="7"
                                                    Background="{Binding AccentBrush}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                                            <StackPanel HorizontalAlignment="Center" Margin="4,8">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="17"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{Binding AccentBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                     Value="True">
                                            <Setter TargetName="PillTint" Property="Opacity" Value="0.06" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                     Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                            <Setter TargetName="PillTint" Property="Opacity" Value="0.13" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Fan Strategy Quick Selector -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10,9" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="风扇策略" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Rocket24" FontSize="12" Foreground="#FF6B4A"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Turbo 强冷" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ToggleButton Style="{StaticResource SwitchToggleSmallStyle}"
                                              IsChecked="{Binding IsTurboFan, Mode=TwoWay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ListBox ItemsSource="{Binding FanModeOptions}"
                                 SelectedItem="{Binding SelectedFanModeOption, Mode=TwoWay}"
                                 Style="{StaticResource SelectionListBox}"
                                 Margin="-2,8,-2,0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionListBoxItem}">
                                    <Setter Property="Margin" Value="2,0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="FanPill"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1.2"
                                            CornerRadius="8"
                                            Padding="0">
                                        <Grid>
                                            <Border x:Name="FanPillTint"
                                                    CornerRadius="7"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                                            <StackPanel HorizontalAlignment="Center" Margin="4,8">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                     Value="True">
                                            <Setter TargetName="FanPillTint" Property="Opacity" Value="0.06" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                     Value="True">
                                            <Setter TargetName="FanPill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="FanPillTint" Property="Opacity" Value="0.14" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Footer Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Appearance="Secondary" HorizontalAlignment="Stretch"
                               Margin="0,0,8,0" Padding="10,7" CornerRadius="8"
                               Click="OpenMain_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Window24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="显示主界面" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Grid.Column="1" Appearance="Secondary"
                               Padding="12,7" CornerRadius="8"
                               Click="ExitApp_Click" ToolTip="彻底退出程序">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Power24" FontSize="14" Foreground="#FF6B4A" Margin="0,0,6,0" />
                            <TextBlock Text="彻底退出" FontSize="12" FontWeight="SemiBold" Foreground="#FF6B4A" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
